NEXT_PUBLIC_API_BASE_URL=https://odefi.onegodian.com/api
NEXT_PUBLIC_SITE_URL=https://odefi.onegodian.com
NEXT_PUBLIC_ODC_NODE_URL=https://odefi.onegodian.com
NEXT_PUBLIC_ODC_CONTRACT_ADDRESS=0x9eee1e3615efe0374a7588d2760db5ffb2d5ce98
NEXT_PUBLIC_ODC_CHAIN_ID=1

# Firebase Web SDK configuration
# Set real values only in the deployment environment or a local .env file.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=(default)
