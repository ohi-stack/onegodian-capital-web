rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 128;
      allow update: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'walletAddress', 'disclosureAcceptedAt', 'updatedAt']);
      allow delete: if false;
    }

    // Certificates are publicly readable for verification
    match /certificates/{certId} {
      allow read: if true;
      allow write: if false; // Admin managed via secure backend
    }

    // Disclosures acknowledgements
    match /disclosures/{ackId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.disclosureCategory is string
        && request.resource.data.acknowledgedAt is string;
      allow update, delete: if false;
    }

    // Ledger records are public audit records
    match /ledger/{entryId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
